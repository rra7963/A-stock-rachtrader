# Copy to /opt/trading-agents-adapted/.event-plan-api.env on the server,
# set mode 0600, and replace the placeholder with an independently generated
# high-entropy token. Never commit the populated file.
TRADINGAGENTS_API_BEARER_TOKEN=
# Bounded portfolio worker count. The API also defaults to 4 when this line is
# absent on an existing server; accepted values are 1 through 4.
TRADINGAGENTS_PORTFOLIO_ANALYSIS_CONCURRENCY=4
